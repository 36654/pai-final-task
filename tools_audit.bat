@echo off
chcp 65001 >nul
rem tools_audit.bat : READ-ONLY. Lists every file in pai_tools (size, date, sha16, role) and flags unregistered / changed / missing files, duplicates, and tool code embedded in bats. Changes nothing.
setlocal
set "HERE=%~dp0"
if not exist "%HERE%cexec.bat" (echo Put this file in the pai_tools folder, next to cexec.bat & pause & exit /b 1)
set "TMPD=%TEMP%\ptaudit"
if exist "%TMPD%" rmdir /s /q "%TMPD%"
mkdir "%TMPD%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $m=[ordered]@{}; Get-Content -LiteralPath '%~f0' -Encoding Ascii | ForEach-Object { if ($_.StartsWith(':::')) { $p=$_.Substring(3).Split('|'); if (-not $m.Contains($p[0])) { $m[$p[0]]='' }; $m[$p[0]]+=$p[1] } }; foreach ($k in $m.Keys) { [IO.File]::WriteAllBytes((Join-Path '%TMPD%' $k),[Convert]::FromBase64String($m[$k])) }"
if errorlevel 1 (
  echo extract failed
  pause
  exit /b 1
)
powershell -NoProfile -ExecutionPolicy Bypass -File "%TMPD%\audit.ps1" -Here "%HERE%."
echo.
pause
exit /b 0
:::audit.ps1|
:::audit.ps1|
:::audit.ps1|
